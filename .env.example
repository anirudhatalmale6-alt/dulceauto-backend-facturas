# Copiar a .env y cambiar TODOS los valores antes de poner en produccion.

# Clave de firma de la cookie de sesion. Generar una nueva con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambiar-esta-clave-en-produccion

# Credenciales iniciales. Solo se usan la primera vez, para sembrar la base.
# Despues viven hasheadas en la tabla credential y se cambian desde el panel.
INITIAL_ADMIN_USER=admin
INITIAL_ADMIN_PASSWORD=DulceAuto2026
INITIAL_MASTER_PASSWORD=Master2026

# En el servidor, con certificado: true. En local: false.
# Con true la cookie de sesion solo viaja por HTTPS.
HTTPS_ONLY=false

# Minutos de inactividad antes de que Configuracion se vuelva a bloquear sola.
MASTER_SESSION_MINUTES=15
# Minutos de inactividad antes de cerrar la sesion del panel.
SESSION_MINUTES=480

# Vacio = sqlite en data/dulceauto.db.
# Para migrar en el futuro basta con cambiar esta linea, por ejemplo:
#   DATABASE_URL=postgresql+psycopg://usuario:clave@localhost/dulceauto
#   DATABASE_URL=mysql+pymysql://usuario:clave@localhost/dulceauto
DATABASE_URL=
